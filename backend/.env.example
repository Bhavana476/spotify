# Copy to .env and fill in. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-string
# SQLite (zero setup) by default; for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://dj:password@localhost:5432/djstudio
DATABASE_URL=sqlite+aiosqlite:///./djstudio.db
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Optional: enables Claude-generated banter/answers (template fallback otherwise)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=2.5
# Demo pacing: >1 speeds up the simulated playback clock
PLAYBACK_SPEED=1
OUTRO_WINDOW_SECONDS=20
SENTIMENT_WINDOW_SECONDS=30
RECONNECT_GRACE_SECONDS=10
SEED_PASSWORD=djstudio-demo
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
